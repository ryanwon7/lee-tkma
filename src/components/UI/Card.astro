---
export interface Props {
  title: string;
  image?: {
    src: string;
    alt: string;
    /** Controls which part of the image stays visible (e.g. 'center', 'top', '50% 25%', 'left 40%') */
    position?: string;
  };
  href?: string;
  className?: string;
  imageLayout?: 'top' | 'background';
}

const {
  title,
  image,
  href,
  className = "",
  imageLayout = 'top'
} = Astro.props;

const Element = href ? "a" : "div";
const imagePosition = image?.position ?? "center";
---

<Element
  href={href}
  aria-label={href ? title : undefined}
  class:list={[
    "card group overflow-hidden",
    { "relative": imageLayout === "background" },
    className
  ]}
>
  {image && imageLayout === "background" && (
    <div
      class="absolute inset-0 overflow-hidden"
      style={{
        backgroundImage: `url(${image.src})`,
        backgroundSize: "cover",
        backgroundPosition: imagePosition
      }}
      aria-hidden="true"
    />
  )}

  {image && imageLayout === "top" && (
    <div class="overflow-hidden aspect-[16/9]">
      <img
        src={image.src}
        alt={image.alt}
        style={{ objectPosition: imagePosition }}
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    </div>
  )}

  <div class:list={[
    "p-5",
    { "relative": imageLayout === "background" }
  ]}>
    <h3 class="mb-2 text-xl font-bold">{title}</h3>
    <div class="text-gray-700">
      <slot />
    </div>
  </div>
</Element>
