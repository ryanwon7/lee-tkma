    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-3 gap-8 mb-12">
      <!-- Church Info -->
      <div class="hidden md:block lg:block">
        <div class="text-left">
        <!-- Studio Hours -->
          <div class="text-gray-300">
            <h4 class="mb-2 text-gray-300">{header}</h4>
            {
                <div class="text-sm">
                  <p><strong class="text-gray-300">Mon-Fri:</strong> {monfrihours}</p>
                  <p><strong class="text-gray-300">Saturday:</strong> By Appointment</p>
                  <p><strong class="text-gray-300">Sunday:</strong> Closed</p>
                </div>
