---
import { getCollection } from "astro:content";

// Current year for copyright
const currentYear = new Date().getFullYear();
const currentMonth = new Date().getMonth();
let header;
let monfrihours;

switch (currentMonth) {
  case 9:
  case 10:
  case 11:
    header = "Studio Hours - Fall"
    monfrihours = "5:00 PM - 8:30 PM"
    break;
  case 12:
  case 1:
  case 2:
    header = "Studio Hours - Winter"
    monfrihours = "5:00 PM - 8:30 PM"
    break;
  case 3:
  case 4:
  case 5:
    header = "Studio Hours - Spring"
    monfrihours = "5:00 PM - 8:30 PM"
    break;
  case 6:
  case 7:
  case 8:
    header = "Studio Hours - Summer"
    monfrihours = "8:00 PM - 7:30 PM"
    break;
default:
    header = "Studio Hours"
    monfrihours = "5:00 PM - 8:30 PM"
}
---

