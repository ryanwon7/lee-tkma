---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/Sections/PageHeader.astro";
import Card from "../../components/UI/Card.astro";
import { getCollection } from "astro:content";

// Fetch all ministries
const all = await getCollection("classes", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
);
// Sort by order or name
const classes = all.sort((a, b) =>
  (a.data.order ?? 0) - (b.data.order ?? 0) ||
  a.data.name.localeCompare(b.data.name)
);
---

<BaseLayout title="Classes" description="Learn more about the different martial arts classes we offer.">
  <PageHeader
    title="Classes"
    backgroundImage="/uploads/classes-header-bg.jpg"
  />
  
  <section class="py-10 bg-white">
      <div class="text-center">
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          We offer many different martial arts classes, suitable for all ages and experiences, making it easy to find a class where you can learn the best.
        </p>
      </div>
  </section>
  <!-- Programs Grid -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {classes.map((cls) => (
          <Card
            title={cls.data.name}
            image={{
              src: cls.data.logo,
              alt: cls.data.name,
              position: cls.data.image_position
            }}
            href={`/classes/${cls.slug}`}
            className="opacity-90 hover:opacity-100"
          >
            <div class="mb-3 flex items-center text-gray-600">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span>{cls.data.occurs}</span>
                </div>
            <div class="mb-3 flex items-center text-gray-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>{cls.data.days}</span>
            </div>
            
            
            <p class="text-gray-700 mb-4">{cls.data.summary}</p>

            <p class="text-primary-600 font-medium group-hover:underline group-hover:text-primary-700">
              View Details →
            </p>
          </Card>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
