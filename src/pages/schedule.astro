---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/Sections/PageHeader.astro";
---

<BaseLayout
  title="Schedule"
  description="Check out our Taekwondo's weekly schedule of programs."
>
  <PageHeader 
    title="Schedule" 
    subtitle="This Week’s Schedule: October 13 - October 19"
    backgroundImage="/uploads/schedule-header.jpg"
  />
  
  <!-- Mission & Vision -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <div class="flex justify-center">
          <img 
            src="/uploads/schedules/Class schedule(Oct 27 ~ Nov 1).png" 
            alt="This Week's Schedule" 
            class="rounded-lg shadow-lg object-cover w-3/4 h-auto max-w-4xl"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>