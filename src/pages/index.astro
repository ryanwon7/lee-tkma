---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/Sections/HeroSection.astro";
import Button from "../components/UI/Button.astro";
import Card from "../components/UI/Card.astro";
---

<BaseLayout>
  <HeroSection 
    title="Tiger Kicks Martial Arts"
    subtitle="Better Shape, Better Condition, Better Life!"
    backgroundImage="/uploads/hero-bg.jpg"
    ctaText="Free Trial Offer"
    ctaLink="/free-trial?subject=Free+Trial+Class"
    secondaryCtaText="View Classes"
    secondaryCtaLink="/classes"
  />
  
  <!-- About Section -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <img 
            src="/uploads/TKMA-Black.png" 
            alt="Our Church" 
            class="rounded-lg shadow-lg object-cover w-full h-full"
          />
        </div>
        
        <div>
          <h2 class="text-3xl md:text-4xl font-bold mb-6">About Tiger Kicks Martial Arts</h2>
          <p class="text-gray-700 mb-6 text-lg">
            Tiger Kicks Martial Arts is a Taekwondo studio in Warminster, PA. Run by Master Jookyeong Lee, we have been providing detailed instruction and programs in martials arts for years to our students, with engaging classes and various other activities and program available as well. Browse our site to see the various classes we offer, or click the link below to learn more about our studio and instructors.</p>
          <Button href="/about-us">
            Learn More About Us
          </Button>
        </div>
      </div>
    </div>
  </section>

  
  <!-- Class and Activities Preview -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Our Classes and Programs</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          See the various martial arts classes and programs we offer at TKMA.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="card text-center">
          <Card
            title="Tiger Cubs and Junior Tiger Classes"
            image={{
              src: "/uploads/classes/tigercubs.jpg",
              alt: "Tiger Cubs",
              position: "50% 38%"
            }}
            href={`/classes/tiger-cubs`}
            className="opacity-90 hover:opacity-100"
          >
          <p class="text-gray-700 mb-4">
            Kids learn confidence and martial arts skills in a fun setting in our Tiger Cubs (ages 4-5) and Junior Tiger (ages 6-12) classes!
          </p>
          <a href="/classes/tiger-cubs" class="text-primary-600 font-medium hover:text-primary-700">
            More about Tiger Cubs →
          </a>
          <br>
          <a href="/classes/junior-tigers" class="text-primary-600 font-medium hover:text-primary-700">
            More about Junior Tigers →
          </a>
          </Card>
        </div>
        <div class="card text-center">
          <Card
            title="Martial Arts Summer Camp"
            image={{
              src: "/uploads/programs/summercamp.jpg",
              alt: "Summer Camp",
              position: "top center"
            }}
            href={`/programs/summer-camp`}
            className="opacity-90 hover:opacity-100"
          >
          <p class="text-gray-700 mb-4">
            Students learn martial arts skills along with other physical activities and academic curriculum in our summer camp!
          </p>
          <a href="/programs/summer-camp" class="text-primary-600 font-medium hover:text-primary-700">
            More about Summer Camp →
          </a>
          </Card>
        </div>
        <div class="card text-center">
          <Card
            title="Family, Teen, and Adult Class"
            image={{
              src: "/uploads/classes/familyclass.jpg",
              alt: "Family Class",
              position: "50% 66%"
            }}
            href={`/classes/family-class`}
            className="opacity-90 hover:opacity-100"
          >
          <p class="text-gray-700 mb-4">
            Students of all skills and ages are welcome to learn together in our Family, Teen, & Adult class!
          </p>
          <a href="/classes/family-class" class="text-primary-600 font-medium hover:text-primary-700">
            More about Family Class →
          </a>
          <br>
          </Card>
        </div>
      </div>
      <div class="mt-12 text-center">
        <Button href="/classes" variant="primary">
          View All Classes
        </Button>
        <Button href="/programs" variant="secondary">
          View All Programs
        </Button>
      </div>
    </div>
  </section>
  
  <!-- Reviews -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Reviews from our students</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
          <div class="bg-gray-50 p-8 rounded-lg shadow-sm">
            <p class="text-gray-600 mb-4">“Master Lee is a phenomenal TKD instructor. He helped our son to develop confidence, discipline, and improve self-control.”</p>
            <h3 class="text-xl font-bold mb-3">- Art Kh</h3>
          </div>
          
          <div class="bg-gray-50 p-8 rounded-lg shadow-sm">
            <p class="text-gray-600 mb-4">“The most caring, friendly and welcoming environment is here at Master Lee’s Tiger Kicks! Definitely recommend.</p>
            <h3 class="text-xl font-bold mb-3">- Ryan Won</h3>
          </div>
          
          <div class="bg-gray-50 p-8 rounded-lg shadow-sm">
            <p class="text-gray-600 mb-4">“My kids joined the summer camp this year and they just love going to Tiger Kicks everyday! They have variety of fun programs and different field trips every week.  Also they have Korean class, art class, and of course they learn new Tae Kwon Do moves too.  I am definitely coming back next year!”</p>
            <h3 class="text-xl font-bold mb-3">- Clara Hong</h3>
          </div>
          
          <div class="bg-gray-50 p-8 rounded-lg shadow-sm">
            <p class="text-gray-600 mb-4">“Wonderful studio with top notch instruction. It's a process that requires dedication over a couple of years but the journey is well worth it.... highly recommend.”</p>
            <h3 class="text-xl font-bold mb-3">- Yulia Portman</h3>
          </div>
        </div>
        
      </div>
    </div>
  </section>
  
</BaseLayout>