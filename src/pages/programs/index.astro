---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/Sections/PageHeader.astro";
import Card from "../../components/UI/Card.astro";
import { getCollection } from "astro:content";

// Fetch all classes
const all = await getCollection("programs", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
);
// Sort by order or name
const programs = all.sort((a, b) =>
  (a.data.order ?? 0) - (b.data.order ?? 0) ||
  a.data.name.localeCompare(b.data.name)
);
---

<BaseLayout title="Programs" description="Discover our many programs and extracurricular fun.">
  <PageHeader
    title="Programs"
    backgroundImage="/uploads/programs-header-bg.jpg"
  />
  
  <section class="py-10 bg-white">
      <div class="text-center">
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          At Tiger Kicks, we offer many different programs and activities outside of our regular classes. Learn more about what programs we have to offer.
        </p>
      </div>
  </section>
  <!-- Programs Grid -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {programs.map((program) => (
          <Card
            title={program.data.name}
            image={{
              src: program.data.logo,
              alt: program.data.name,
              position: program.data.image_position
            }}
            href={`/programs/${program.slug}`}
            className="opacity-90 hover:opacity-100"
          >
            <div class="mb-3 flex items-center text-gray-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>{program.data.availability}</span>
            </div>
            
            
            <p class="text-gray-700 mb-4">{program.data.summary}</p>

            <p class="text-primary-600 font-medium group-hover:underline group-hover:text-primary-700">
              View Details →
            </p>
          </Card>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
