---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/Sections/PageHeader.astro";
import Button from "../../components/UI/Button.astro";
import Gallery from '../../components/UI/Gallery.astro';
import { getCollection } from "astro:content";

// Generate static paths for all programs
export async function getStaticPaths() {
  try {
    const programEntries = await getCollection("programs", ({ data }) => {
      return import.meta.env.PROD ? !data.draft : true;
    });

    return programEntries.map(entry => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
  } catch (error) {
    // If the collection doesn't exist yet, return an empty array
    return [];
  }
}

// Get the Programs data
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout
  title={`${entry.data.name} - Church Name`}
  description={entry.data.summary}
  image={entry.data.logo ? { url: entry.data.logo, alt: entry.data.name } : undefined}
>
  <PageHeader 
    title={entry.data.name} 
    backgroundImage="/uploads/programs-header-bg.jpg"
  />

  
  <section class="py-16 bg-gray-50">
    <div class="container">
  

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main Content -->
         
        <div class="lg:col-span-2">
      <Gallery folder={entry.data.gallery} alt="Summer Camp" aspect="3/2" auto={true} delay={4000} />
          
          <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-h2:text-2xl prose-h3:text-xl prose-h4:text-lg prose-p:text-gray-700 prose-li:text-gray-700 prose-strong:text-gray-900">
            <Content />
          </div>
        </div>
        
        <!-- Sidebar -->
        <div>
          <div class="bg-gray-50 p-6 rounded-lg shadow-sm sticky top-24">
            
            <h3 class="text-xl font-bold mb-4">Program Information</h3>
            
            <div class="space-y-4 mb-6">
              {entry.data.availability && (
                <div>
                  <h5 class="font-bold text-gray-700">Availability</h4>
                  <p class="font-bold text-gray-700">{entry.data.availability}</p>
                </div>
              )}
              {entry.data.days && (
                <div>
                  <h5 class="font-bold text-gray-700">Days</h4>
                  <p class="font-bold text-gray-700">{entry.data.days}</p>
                </div>
              )}
            </div>
            
            <div class="flex flex-col space-y-3">
              <Button href="/contact?subject=Programs+Inquiry" variant="primary">
                Interested? Contact Us
              </Button>
              
              <Button href="/programs" variant="outline">
                Back to All Programs
              </Button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>