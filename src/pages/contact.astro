---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/Sections/PageHeader.astro";

const WEB3FORMS_ACCESS_KEY = import.meta.env.WEB3FORMS_ACCESS_KEY || "";
---

<BaseLayout
  title="Contact"
  description="Get in touch with TKMA Taekwondo Academy. Contact us for class information, training schedules, belt testing, competitions, and enrollment. Visit our dojang or reach out to our instructors."
>
  <PageHeader
    title="Contact"
    subtitle="We'd love to hear from you"
    backgroundImage="/uploads/contact-header.jpg"
  />

  <!-- Contact Information -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <!-- Contact Form -->
        <div class="md:col-span-2">
          <h2 class="text-4xl font-bold text-gray-800 mb-6">
            Contact Us
          </h2>
          <div class="container mx-auto max-w-4xl">
            <form
              id="contact-form"
              action="https://api.web3forms.com/submit"
              method="POST"
              class="grid grid-cols-1 md:grid-cols-2 gap-6"
            >
              <!-- Web3Forms Access Key -->
              <input
                type="hidden"
                name="access_key"
                value={WEB3FORMS_ACCESS_KEY}
              />

              <!-- Disable hCaptcha temporarily -->
              <input type="hidden" name="captcha" value="false" />
              <input type="hidden" name="_captcha" value="false" />

              <!-- Spam Prevention: Honeypot -->
              <input
                type="checkbox"
                name="botcheck"
                class="hidden"
                style="display: none;"
              />

              <!-- No redirect - handle success in same page -->

              <!-- Form Fields -->
              <div class="md:col-span-2">
                <label
                  for="name"
                  class="block text-sm font-medium text-gray-700 mb-1"
                  >Name *</label
                >
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  minlength="2"
                  maxlength="50"
                  class="border border-gray-300 rounded-md p-3 w-full focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors text-gray-800"
                />
              </div>

              <div class="md:col-span-2">
                <label
                  for="email"
                  class="block text-sm font-medium text-gray-700 mb-1"
                  >Email Address *</label
                >
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="border border-gray-300 rounded-md p-3 w-full focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors text-gray-800"
                />
              </div>

              <div>
                <label
                  for="phone"
                  class="block text-sm font-medium text-gray-700 mb-1"
                  >Phone Number</label
                >
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  pattern="^[0-9]{10}$"
                  placeholder="1234567890"
                  class="border border-gray-300 rounded-md p-3 w-full focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors text-gray-800"
                />
              </div>
              <div class="md:col-span-2">
                <label
                  for="subject"
                  class="block text-sm font-medium text-gray-700 mb-1"
                  >Subject</label
                >
                <select
                  id="subject"
                  name="subject"
                  required
                  class="border border-gray-300 rounded-md p-3 w-full focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors text-gray-800"
                >
                  <option value="">Select a subject</option>
                  <option value="General Questions">General Questions</option>
                  <option value="Free Trial Class">Free Trial Class</option>
                  <option value="Business Opportunities">Business Opportunities</option>
                  <option value="Other">Other</option>
                </select>
              </div>

              <div class="md:col-span-2">
                <label
                  for="message"
                  class="block text-sm font-medium text-gray-700 mb-1"
                  >Message *</label
                >
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  required
                  minlength="10"
                  maxlength="1000"
                  placeholder="Tell us about your interest in Taekwondo, any experience level, specific questions, or anything else you'd like us to know..."
                  class="border border-gray-300 rounded-md p-3 w-full focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors resize-y text-gray-800"
                ></textarea>
                <div class="text-sm text-gray-500 mt-1">
                  <span id="char-count">0</span>/1000 characters
                </div>
              </div>

              <!-- Simple Human Verification 
              <div class="md:col-span-2">
                <div class="bg-gray-50 p-4 rounded-lg border">
                  <label class="flex items-center space-x-3 cursor-pointer">
                    <input
                      type="checkbox"
                      id="human-check"
                      name="human_verification"
                      required
                      class="h-5 w-5 text-primary-600 border-2 border-gray-300 rounded focus:ring-primary-500"
                    />
                    <span class="text-sm font-medium text-gray-700">
                      I'm not a robot 🤖
                    </span>
                  </label>
                  <p class="text-xs text-gray-500 mt-1 ml-8">
                    Please check this box to verify you're human
                  </p>
                </div>
              </div> -->

              <!-- Submit Button -->
              <div class="md:col-span-2">
                <button
                  type="submit"
                  id="submit-btn"
                  class="bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-md px-8 py-3 transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  <span class="submit-text">Send Message</span>
                  <span class="loading-text hidden">Sending...</span>
                </button>
              </div>

              <!-- Form Status Messages -->
              <div class="md:col-span-2">
                <div id="form-status" class="hidden mt-4 p-4 rounded-md"></div>
              </div>
            </form>
          </div>
        </div>
        <!-- Contact Information -->
        <div class="md:col-span-1">
          <h2 class="text-4xl font-bold text-gray-800 mb-6">
            Contact Information
          </h2>

          <div class="space-y-8">
            <div class="flex items-start">
              <div class="flex-shrink-0 mt-1">
                <div
                  class="w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6 text-primary-600"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    ></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-xl font-bold mb-1">Address</h3>
                <address class="not-italic text-gray-700">
                  <p>317 E Street Rd</p>
                  <p>Warminster, PA 18974</p>
                </address>
              </div>
            </div>

            <div class="flex items-start">
              <div class="flex-shrink-0 mt-1">
                <div
                  class="w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6 text-primary-600"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                    ></path>
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-xl font-bold mb-1">Phone</h3>
                <p class="text-gray-700">
                  <a href="tel:+12154440899" class="hover:text-primary-600">
                    (215) 444-0899
                  </a>
                </p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="flex-shrink-0 mt-1">
                <div
                  class="w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6 text-primary-600"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    ></path>
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-xl font-bold mb-1">Email</h3>
                <p class="text-gray-700">
                  <a
                    href="mailto:masterleetigerkicks@gmail.com"
                    class="hover:text-primary-600"
                  >
                    masterleetigerkicks@gmail.com
                  </a>
                </p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="flex-shrink-0 mt-1">
                <div
                  class="w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6 text-primary-600"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-xl font-bold mb-1">Studio Hours</h3>
                <div class="text-gray-700">
                  <p><strong>Monday - Friday:</strong> 5:00 PM - 8:00 PM</p>
                  <p><strong>Saturday:</strong> By Appointment</p>
                  <p><strong>Sunday:</strong> Closed</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Load hCaptcha and form validation script -->
  <script src="https://web3forms.com/client/script.js" async defer></script>

  <!-- <script>
    // Character counter for message field
    const messageField = document.getElementById(
      "message",
    ) as HTMLTextAreaElement | null;
    const charCount = document.getElementById(
      "char-count",
    ) as HTMLElement | null;

    if (messageField && charCount) {
      messageField.addEventListener("input", function () {
        if (charCount) {
          charCount.textContent = (
            this as HTMLTextAreaElement
          ).value.length.toString();
        }
      });
    }

    // Form submission handling with additional validation
    const form = document.getElementById(
      "contact-form",
    ) as HTMLFormElement | null;
    const submitBtn = document.getElementById(
      "submit-btn",
    ) as HTMLButtonElement | null;
    const formStatus = document.getElementById(
      "form-status",
    ) as HTMLElement | null;

    if (form && submitBtn) {
      form.addEventListener("submit", async function (e) {
        e.preventDefault();

        // Show loading state
        submitBtn.disabled = true;
        const submitText = document.querySelector(
          ".submit-text",
        ) as HTMLElement | null;
        const loadingText = document.querySelector(
          ".loading-text",
        ) as HTMLElement | null;

        if (submitText) submitText.classList.add("hidden");
        if (loadingText) loadingText.classList.remove("hidden");

        // Additional client-side spam check
        const honeypot = form.querySelector(
          'input[name="botcheck"]',
        ) as HTMLInputElement | null;
        if (honeypot && honeypot.checked) {
          showMessage("Spam detected. Please try again.", "error");
          resetSubmitButton();
          return;
        }

        // Simple human verification check
        const humanCheck = form.querySelector(
          "#human-check",
        ) as HTMLInputElement | null;
        if (!humanCheck || !humanCheck.checked) {
          showMessage(
            "Please verify that you are human by checking the box.",
            "error",
          );
          resetSubmitButton();
          return;
        }

        // Check for suspicious patterns
        const messageTextarea = form.querySelector(
          "#message",
        ) as HTMLTextAreaElement | null;
        if (!messageTextarea) {
          showMessage("Message field not found.", "error");
          resetSubmitButton();
          return;
        }

        const message = messageTextarea.value;
        const suspiciousPatterns = [
          /http[s]?:\/\//gi, // URLs
          /\b(buy|cheap|discount|free|money|earn|cash|loan)\b/gi, // Spam keywords
          /(.)\1{10,}/gi, // Repeated characters
        ];

        const hasSuspiciousContent = suspiciousPatterns.some((pattern) =>
          pattern.test(message),
        );
        if (hasSuspiciousContent) {
          showMessage(
            "Your message contains suspicious content. Please revise and try again.",
            "error",
          );
          resetSubmitButton();
          return;
        }

        try {
          const formData = new FormData(form);

          // Add additional form data for Web3Forms
          formData.append(
            "from_name",
            `${(form.querySelector("#firstname") as HTMLInputElement)?.value} ${(form.querySelector("#lastname") as HTMLInputElement)?.value}`,
          );
          formData.append(
            "subject",
            "New Contact Form Submission - TKMA Taekwondo",
          );

          const response = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            headers: {
              Accept: "application/json",
            },
            body: formData,
          });

          const result = await response.json();

          if (response.ok && result.success) {
            showMessage(
              "Thank you! Your message has been sent successfully. We'll get back to you soon.",
              "success",
            );
            form.reset();
            if (charCount) charCount.textContent = "0";
            // Uncheck the human verification box
            if (humanCheck) humanCheck.checked = false;
          } else {
            console.error("Web3Forms error:", result);
            throw new Error(result.message || "Form submission failed");
          }
        } catch (error) {
          console.error("Form submission error:", error);
          const errorMessage =
            error instanceof Error ? error.message : "Unknown error";
          showMessage(
            `Sorry, there was an error: ${errorMessage}. Please try again or contact us directly at masterleetigerkicks@gmail.com`,
            "error",
          );
        }

        resetSubmitButton();
      });
    }

    function showMessage(message: string, type: string): void {
      if (formStatus) {
        formStatus.className = `mt-4 p-4 rounded-md ${type === "success" ? "bg-green-100 text-green-800 border border-green-200" : "bg-red-100 text-red-800 border border-red-200"}`;
        formStatus.textContent = message;
        formStatus.classList.remove("hidden");

        // Hide message after 5 seconds
        setTimeout(() => {
          if (formStatus) formStatus.classList.add("hidden");
        }, 5000);
      }
    }

    function resetSubmitButton(): void {
      if (submitBtn) {
        submitBtn.disabled = false;
        const submitText = document.querySelector(
          ".submit-text",
        ) as HTMLElement | null;
        const loadingText = document.querySelector(
          ".loading-text",
        ) as HTMLElement | null;

        if (submitText) submitText.classList.remove("hidden");
        if (loadingText) loadingText.classList.add("hidden");
      }
    }
  </script>
</BaseLayout>
