---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/Sections/PageHeader.astro";
---

<BaseLayout
  title="About Us"
  description="Learn about our dojang and our instructor."
>
  <PageHeader 
    title="About Us" 
    subtitle="Our School and Instructor"
    backgroundImage="/uploads/about-header.png"
  />
  
  <!-- About Dojang -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <img 
            src="/uploads/tkma-round-logo.jpg"
            alt="Worship at our church" 
            class="rounded-lg shadow-lg object-cover w-full h-full"
          />
        </div>

        <div>
          <h2 class="text-3xl md:text-4xl font-bold mb-6">Tiger Kicks Martial Arts</h2>
          <p class="text-xl text-gray-700 mb-8">
            Master Lee’s Tiger Kicks Martial Arts is a TaeKwonDo studio in Warminster, PA, in business since 2017. The studio is founded and run by Master Jookyeong Lee, a world class Taekwondo Athlete who competed at the national level in South Korea.
          </p>
          
          <p class="text-xl text-gray-700 mb-8">
            Tiger Kicks Martial Arts has been teaching traditional Korean martial arts to students in the tri-state area, with locations all throughout PA and DE, with the first Tiger Kicks Martial Arts branch having been open since 2008 (?). Click below to view some of our other Tiger Kicks locations.
          </p>
        </div>
        
      </div>
    </div>
  </section>
    
  <!-- About Master Lee -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">

        <div>
          <h2 class="text-3xl md:text-4xl font-bold mb-6">Instructor Jookyeong Lee</h2>
          <h4 class="text-1xl md:text-2xl text-primary-700 mb-6">Biography</h2>
          <p class="text-xl text-gray-700 mb-8">
            Born in ?. South Korea, Master Jookyeong Lee had a passion for TaeKwonDo from a young age, and attended YongIn University  in Seoul, South Korea for TaeKwonDo. He competed in ______ and was a participant of _____. He moved to the US in 20??, and opened his own TaeKwonDo studio in Warminster in 2017.
          </p>
          <h4 class="text-1xl md:text-2xl text-primary-700 mb-6">Accomplishments</h2>
          <ul class="text-xl text-gray-700 mb-8 list-disc list-inside">
            <li>7th Degree in Taekwondo (World Taekwondo Headquarters Kukkiwon Dan Certificate)</li>
            <li>? Degree in Judo</li>
            <li>? Degree in Hapkido</li>
            <li>Gold Medal Winner at ?</li>
            <li>Graduated from YongIn University in ?</li>
            <li>Other Certifications </li>
          </ul>
        </div>

        <div>
          <img 
            src="/uploads/master-lee.jpg"
            alt="Instructor Jookyeong Lee" 
            class="rounded-lg shadow-lg object-cover w-full h-full"
          />
        </div>
        
      </div>
    </div>
  </section>
  
</BaseLayout>